{
	"name": "pinyin-companion",
	"version": "0.3.3",
	"description": "Obsidian plugin: add tone-marked pinyin after Chinese text, using the Chinese as the source of truth.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit",
		"test": "vitest run",
		"lint": "eslint .",
		"package": "npm run build && node scripts/package.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/commands": "6.8.1",
		"@codemirror/language": "6.11.3",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.27.7",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "26.1.0",
		"obsidian": "1.12.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "5.1.0"
	},
	"author": "",
	"dependencies": {
		"opencc-js": "1.4.2",
		"pinyin-pro": "3.29.5"
	}
}
